# The CLI image of Claude sessions (Decision 0087, 4). Build it, then pin the
# digest in /etc/paw/cli-session.toml:
#   podman build -t localhost/paw-claude-cli -f Containerfile ..
#   podman image inspect --format '{{.Digest}}' localhost/paw-claude-cli
# Pin the base image's digest and Claude Code's version before building (an
# update repeats the fake CLI's stream check and the smoke test).
FROM docker.io/library/node:22-bookworm-slim
ARG CLAUDE_CODE_VERSION
RUN test -n "$CLAUDE_CODE_VERSION" \
    && apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force
COPY cli-session/start-claude cli-session/paw_mcp_relay.py egress/paw_egress.py /opt/paw/
# No entry point: the backend names /opt/paw/start-claude as the command
# (ClaudeSessionAdapter(executable=("/opt/paw/start-claude",))).
