# One CLI session's container (Decision 0083, 6; Decision 0087, 4;
# deploy/cli-session/README.md). The backend starts and stops exactly these
# units (polkit: 50-paw-cli-session.rules); the instance is the session's UUID.
#
# Rootless Podman under these restrictions is what the deployment verifies
# first (Decision 0083's approval, condition (1)); if it does not run, use the
# single-uid mapping of README.md (no newuidmap) and keep the hardening.

[Unit]
Description=Personal AI Workspace CLI session %i
After=paw-egress.service

[Service]
Type=exec
User=paw-agent-cli
Group=paw-cli-bridge
Environment=HOME=/var/lib/paw-agent-cli
# Rootless Podman's runtime directory (its runroot and tmpdir): the unit's own,
# because ProtectHome=yes hides /run/user.
RuntimeDirectory=paw-cli-session/%i
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/paw-cli-session/%i
ExecStart=/usr/bin/python3 -I /usr/local/lib/paw/paw_cli_session_run.py %i
ExecStopPost=-/usr/bin/podman rm --force --ignore paw-cli-%i
# Rootless Podman creates the container's cgroup below the unit's (memory,
# CPU and PID limits): the unit's cgroup is delegated to it.
Delegate=yes
# An OOM kill in the container (its cgroup is below the unit's: podman run
# --cgroups=split) stops the whole unit with Result=oom-kill, which the backend
# reads before it stops the unit (Decision 0092, 4; issue #251). Delegate=yes
# alone would make it OOMPolicy=continue, and systemd sees the kill only with
# memory accounting.
OOMPolicy=stop
MemoryAccounting=yes
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5s
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/paw-agent-cli /run/paw-cli
UMask=0077
