#!/usr/sbin/nft -f
# The paw-egress account's own outbound traffic (Decision 0087, 3): DNS to the
# host's resolver and TCP 443 to global addresses only. The host-name allowlist
# is the proxy's; this rule set is the second line if the proxy were taken over.
# Load it with your other rules (as root: nft -f paw-egress.nft) and adjust the
# resolver address to /etc/resolv.conf's (systemd-resolved: 127.0.0.53).

table inet paw_egress {
    set not_global4 {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
                     169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
                     192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24,
                     203.0.113.0/24, 224.0.0.0/3 }
    }
    set not_global6 {
        type ipv6_addr
        flags interval
        elements = { ::/128, ::1/128, ::ffff:0:0/96, 64:ff9b::/96, 100::/64,
                     2001::/23, 2001:db8::/32, 2002::/16, 3fff::/20, fc00::/7, fe80::/10,
                     fec0::/10,
                     ff00::/8 }
    }

    chain output {
        type filter hook output priority filter; policy accept;
        meta skuid != "paw-egress" accept
        # No shortcut for established flows: every packet of the account's
        # meets the rules below (a reply to an inbound connection would
        # otherwise reach any peer and port).
        # DNS to the host's resolver only.
        # Only flows the account started (ct direction original): a reply to
        # an inbound connection never matches an accept below.
        ip daddr 127.0.0.53 udp dport 53 ct direction original accept
        ip daddr 127.0.0.53 tcp dport 53 ct direction original accept
        # TCP 443 to global addresses.
        ip daddr @not_global4 counter drop
        # IPv6: the global unicast block 2000::/3 only, less the special-purpose
        # ranges inside it (not_global6: 2001::/23, the documentation blocks
        # 2001:db8::/32 and 3fff::/20, 6to4; the proxy refuses them too).
        # 2001::/23 is dropped whole on purpose: the few globally reachable
        # blocks inside it (2001:3::/32, 2001:4:112::/48, 2001:20::/28, ...)
        # are no provider's, and this second line errs on the side of less.
        ip6 daddr != 2000::/3 counter drop
        ip6 daddr @not_global6 counter drop
        tcp dport 443 ct direction original accept
        counter drop
    }
}
