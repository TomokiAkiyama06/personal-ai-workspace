# The egress proxy's Unix socket (Decision 0087, 3): systemd makes it with
# the CLI accounts' group and passes it to paw-egress.service, whose own
# process is not in that group (Decision 0088: paw-cli-bridge also reads the
# sessions' credential files). See paw-egress.service for the install steps.

[Unit]
Description=Personal AI Workspace egress proxy socket for CLI sessions

[Socket]
ListenStream=/run/paw-egress/egress.sock
SocketUser=paw-egress
SocketGroup=paw-cli-bridge
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
