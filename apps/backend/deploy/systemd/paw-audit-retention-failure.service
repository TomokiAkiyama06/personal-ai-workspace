# Started by systemd when paw-audit-retention.service fails (OnFailure=).
# The run itself already recorded the failure in audit_events whenever the
# database accepted it (audit.retention.maintenance_failed) and wrote the reason
# to the journal (journalctl -u paw-audit-retention.service).
#
# This unit makes the failure visible to the Owner/Admin on this server: it
# writes a high-priority journal entry and a wall message. Replace ExecStart
# with the notification channel of your deployment (mail, a chat webhook, ...)
# if you have one; keep credentials of that channel out of this file.

[Unit]
Description=Report a failed audit_events retention run of the Personal AI Workspace

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-cat --identifier=paw-audit-retention --priority=crit /bin/echo "audit_events retention maintenance FAILED: see journalctl -u paw-audit-retention.service and audit_events (action audit.retention.maintenance_failed). Partitions run out if this keeps failing."
ExecStart=/usr/bin/wall "Personal AI Workspace: audit_events retention maintenance FAILED (journalctl -u paw-audit-retention.service)."
