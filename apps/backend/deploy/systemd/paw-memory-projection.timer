# Runs paw-memory-projection.service every 5 minutes (PAW-045, Decision 0038).
# A run without changes rewrites nothing. The Git backup of the Recovery
# Repository (PAW-047, every 30 minutes) reads this directory.

[Unit]
Description=Memory Markdown Projection of the Personal AI Workspace, every 5 minutes

[Timer]
OnCalendar=*:0/5
# Run at the next boot when the server was off at the scheduled time.
Persistent=true
Unit=paw-memory-projection.service

[Install]
WantedBy=timers.target
