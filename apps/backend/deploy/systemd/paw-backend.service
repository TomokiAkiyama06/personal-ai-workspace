# The Personal AI Workspace backend (Issue #54, Decision 0079): the release
# that /opt/paw/current points at (apps/backend/deploy/release, paw-release).
# paw-release switches the link while this unit is stopped and starts it again
# through the commands of /etc/paw/release.toml; this unit never names a
# version.
#
# User: the backend's own OS user (here paw), never paw-maint nor root. The
# releases under /opt/paw/releases are root-owned and not writable by it.
#
# Install (as root), adjusting the paths and the User to your deployment:
#   cp paw-backend.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now paw-backend.service
#
# /etc/paw/backend.env holds the backend's PAW_* settings (PAW_DATABASE_URL as
# the application role, PAW_WEB_DIST_DIR=/opt/paw/current/apps/web/dist, ...)
# and is readable by root and the backend's user only. It never holds
# PAW_MIGRATION_DATABASE_URL (Decision 0004 5.2).
#
# PAW_RUNTIME_CONFIG_FILE=/etc/paw/runtime.toml in backend.env turns on the
# Compute Scheduler, the local model, the sandbox, git over SSH and the
# orchestrator (Decision 0093; apps/backend/deploy/runtime/runtime.example.toml,
# root:paw 0640). Without it none of them run (one warning at start). A file
# that is wrong stops the start (exit code 2): check it first with
#   sudo -u paw /opt/paw/current/venv/bin/python -m paw_backend.cli \
#     runtime-config-check /etc/paw/runtime.toml

[Unit]
Description=Personal AI Workspace backend
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=exec
User=paw
EnvironmentFile=/etc/paw/backend.env
WorkingDirectory=/opt/paw/current/apps/backend
ExecStart=/opt/paw/current/venv/bin/python -m paw_backend
# The backend's own shutdown closes the open SSE / WebSocket connections within
# PAW_SHUTDOWN_TIMEOUT_SECONDS; an update drains the tasks before it stops this.
KillSignal=SIGTERM
TimeoutStopSec=60s
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
# full, not strict: /usr, /boot and /etc are read-only, but the backend writes
# the users' checkouts (<home>/workspaces/..., PAW_REPOSITORY_WORKSPACE_SUBDIR)
# and the paths of its settings (PAW_MEMORY_PROJECTION_DIR, ...), so /home and
# /srv stay writable (ProtectHome is not set for the same reason).
ProtectSystem=full
# The secret store of the shared connections (Decision 0087, 1;
# deploy/secret-store/README.md): its master key, encrypted with the host key
# (and the TPM2), handed to this unit only (and to the one-shot unit of
# paw-connection-credential-put). Enable it together with PAW_SECRET_STORE_DIR.
#LoadCredentialEncrypted=paw-secret-key:/etc/paw/credentials/paw-secret-key.cred

[Install]
WantedBy=multi-user.target
