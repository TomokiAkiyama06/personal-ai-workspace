#!/bin/sh
# Store a Codex / Claude credential in the secret store (Decision 0087, 2).
#
#   sudo paw-connection-credential-put claude < token.txt
#   sudo paw-connection-credential-put codex  < auth.json
#
# Run as root. The plaintext is read from standard input only and handed to
# `python -m paw_backend.cli connection-credential put` in a one-shot unit
# that runs as the backend's user and loads the same encrypted master key as
# paw-backend.service (LoadCredentialEncrypted=). The command prints the new
# handle; register it as the connection's credential.
set -eu

case "${1:-}" in
    codex|claude) kind=$1 ;;
    *) echo "usage: paw-connection-credential-put codex|claude < credential" >&2; exit 1 ;;
esac

user=${PAW_BACKEND_USER:-paw}
credential=${PAW_SECRET_KEY_CREDENTIAL:-/etc/paw/credentials/paw-secret-key.cred}

exec systemd-run --quiet --pipe --wait --collect \
    --uid="$user" \
    --property=LoadCredentialEncrypted="paw-secret-key:$credential" \
    --property=EnvironmentFile=/etc/paw/backend.env \
    --property=WorkingDirectory=/opt/paw/current/apps/backend \
    --property=NoNewPrivileges=yes \
    --property=PrivateTmp=yes \
    --property=ProtectSystem=full \
    --property=UMask=0077 \
    /opt/paw/current/venv/bin/python -m paw_backend.cli \
    connection-credential put --kind "$kind"
