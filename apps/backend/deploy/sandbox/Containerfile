# The tool sandbox image of Decision 0083 §6 (Issue #208), with the git of
# Decision 0090 1.
#
# Built FROM the benchmark's sandbox image (the image the Main model's numbers of
# Decision 0074 were measured with: Python 3.13, bash, coreutils' `timeout`,
# git), so that the model's `bash` finds the same tools. Added:
#
#   /usr/local/bin/git                  the git front (paw_git_front.py): a call
#                                       aimed at /workspace goes to the shim,
#                                       anything else to the real git
#   /usr/local/lib/paw/paw-git-shim     the git shim (the host's read-only git)
#   /usr/lib/paw/git                    the base image's real git, off PATH
#   /usr/local/lib/paw/paw-file-tool    the helper of the file tools
#
# The base image's git is moved off PATH (its helpers in `git --exec-path` stay,
# they are not on PATH): the build fails if a copy of it is still on PATH under
# any name, so the front is the only `git`. The real git is not a boundary: the
# mounts and masks are (the sandbox sees no git directory of the node's
# repository). The image's USER does not matter: the wrapper runs the container
# and every command as the workspace account's own uid / gid (`--user`,
# `--userns keep-id`). Build (as the account that runs the sandboxes, or load
# the image into each account's rootless storage), then pin it by digest on the
# wrapper's `command=` line (`--sandbox-image=<name>@sha256:<digest>`; a tag is
# refused):
#
#   podman build --build-arg BASE_IMAGE=<benchmark image> \
#     -t paw-sandbox:<date> -f Containerfile .
#   podman image inspect --format '{{.Digest}}' paw-sandbox:<date>
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
RUN install -D -m 0755 "$(command -v git)" /usr/lib/paw/git \
    && rm -f /usr/bin/git /usr/local/bin/git \
       /usr/bin/git-receive-pack /usr/bin/git-upload-archive /usr/bin/git-upload-pack \
    && mkdir -p /usr/local/lib/paw \
    && /usr/lib/paw/git --version \
    && for directory in $(printf '%s' "$PATH" | tr ':' ' '); do \
         for file in "$directory"/*; do \
           if [ -f "$file" ] && cmp -s "$file" /usr/lib/paw/git; then \
             echo "a real git is on PATH: $file" >&2; exit 1; \
           fi; \
         done; \
       done \
    && command -v python3 && command -v bash && command -v timeout
COPY --chmod=0755 paw_git_shim.py /usr/local/lib/paw/paw-git-shim
COPY --chmod=0755 paw_git_front.py /usr/local/bin/git
COPY --chmod=0755 paw_file_tool.py /usr/local/lib/paw/paw-file-tool
